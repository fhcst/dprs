# ==============================================================================
# Daily Training Submit System — 環境變數設定
# ==============================================================================
# 使用方式：複製本檔案為 .env，再填入正式的值：
#   cp .env.example .env
#
# 標記說明：
#   [必填] — 沒有安全的預設值，務必自行設定
#   [選填] — 已有合理預設值，可視需求覆蓋
# ==============================================================================

# ── FastAPI 應用程式 ─────────────────────────────────────────────────────────

# [選填] 執行環境：dev | prod
# - dev:  啟用 auto-reload，Cookie 不帶 Secure flag，允許使用預設 SESSION_SECRET
# - prod: 關閉 auto-reload，Cookie 強制帶 Secure flag，SESSION_SECRET 必須更換
FASTAPI_APP_ENVIRONMENT=dev

# [必填] 用於簽署 JWT token 與 session cookie 的密鑰
# 產生方式：python -c "import secrets; print(secrets.token_hex(32))"
# 注意：prod 環境下若仍使用預設值，應用程式會拒絕啟動
SESSION_SECRET=changeme_session

# [選填] JWT access token 有效期（單位：秒，預設 86400 = 24 小時）
JWT_EXPIRES_SECONDS=86400

# ── MongoDB ──────────────────────────────────────────────────────────────────

# [必填] MongoDB root 帳號密碼
# docker-compose 同時用於初始化資料庫與組裝 app container 的 MONGO_URL 連線字串
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=changeme_mongo

# [選填] 資料庫名稱（預設：dts2）
MONGO_DB_NAME=dts2

# ── Redis ────────────────────────────────────────────────────────────────────

# [必填] Redis 認證密碼
# docker-compose 同時用於 Redis server 啟動與組裝 app container 的 REDIS_URL 連線字串
REDIS_PASSWORD=changeme_redis

# ── Uvicorn / ASGI Server ───────────────────────────────────────────────────
# 以下變數已在 Dockerfile 中設定預設值，僅在需要覆蓋時取消註解

# [選填] Uvicorn 監聽位址（預設：0.0.0.0）
# UVICORN_HOST=0.0.0.0

# [選填] Uvicorn 監聽 port（預設：8000）
# UVICORN_PORT=8000

# [選填] 信任的 reverse proxy IP，用於正確解析 X-Forwarded-* headers
# 多個 IP 以逗號分隔，例如：127.0.0.1,10.0.0.1
# FORWARDED_ALLOW_IPS=

# ── Mongo Express（僅 debug profile）────────────────────────────────────────
# 啟用方式：docker compose --profile debug up

# [選填] Mongo Express Web UI 的 Basic Auth 帳號密碼
ME_USER=admin
ME_PASSWORD=changeme_me
