# ==============================================================================
# Daily Training Submit System — 環境變數設定
# ==============================================================================
# 使用方式：複製本檔案為 .env，再填入正式的值：
#   cp .env.example .env
#
# 標記說明：
#   [必填] — 沒有安全的預設值，務必自行設定
#   [選填] — 已有合理預設值，可視需求覆蓋
# ==============================================================================

# ── FastAPI 應用程式 ─────────────────────────────────────────────────────────

# [選填] 執行環境：dev | prod（預設 prod，採「安全預設」）
# - dev:  啟用 auto-reload，Cookie 不帶 Secure flag，允許使用預設 SESSION_SECRET
# - prod: 關閉 auto-reload，Cookie 強制帶 Secure flag，SESSION_SECRET 必須更換
# 注意：以 Cloudflare Tunnel / 正式部署時「必須」為 prod —— tunnel 在 Cloudflare
#       edge 終結 TLS（browser↔edge 為 HTTPS），唯有 prod 才會發 Secure cookie 並
#       啟用 SESSION_SECRET guard。本範本預設 prod，使 `cp .env.example .env` 後的
#       正式啟動即為安全部署（請務必同時更換 SESSION_SECRET，否則 prod guard 會拒絕啟動）。
#       本機開發改以 `docker compose -f docker-compose.yml -f docker-compose.dev.yml up`
#       顯式疊加 docker-compose.dev.yml，它會把環境覆寫回 dev 並啟用 hot-reload，
#       故毋須為了本機開發而手動改本檔。
FASTAPI_APP_ENVIRONMENT=prod

# [必填] 用於簽署 JWT token 與 session cookie 的密鑰
# 產生方式：python -c "import secrets; print(secrets.token_hex(32))"
# 注意：prod 環境下若仍使用預設值，應用程式會拒絕啟動
SESSION_SECRET=changeme_session

# [選填] JWT access token 有效期（單位：秒，預設 86400 = 24 小時）
JWT_EXPIRES_SECONDS=86400

# ── MongoDB ──────────────────────────────────────────────────────────────────

# [必填] MongoDB root 帳號密碼
# docker-compose 同時用於初始化資料庫與組裝 app container 的 MONGO_URL 連線字串
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=changeme_mongo

# [選填] 資料庫名稱（預設：dts2）
MONGO_DB_NAME=dts2

# ── Redis ────────────────────────────────────────────────────────────────────

# [必填] Redis 認證密碼
# docker-compose 同時用於 Redis server 啟動與組裝 app container 的 REDIS_URL 連線字串
REDIS_PASSWORD=changeme_redis

# ── Uvicorn / ASGI Server ───────────────────────────────────────────────────
# 以下變數已在 Dockerfile 中設定預設值，僅在需要覆蓋時取消註解

# [選填] Uvicorn 監聽位址（預設：0.0.0.0）
# UVICORN_HOST=0.0.0.0

# [選填] Uvicorn 監聽 port（預設：8000）
# UVICORN_PORT=8000

# [tunnel/prod 必填；dev 可留空] 信任的 reverse proxy 來源，用於正確解析
# X-Forwarded-* headers（連動 uvicorn --forwarded-allow-ips）。
# - 本機 dev：可留空＝不信任任何 proxy；保留下方預設值亦無妨（dev 無 proxy 轉發
#   X-Forwarded-*，不影響行為）。
# - Cloudflare Tunnel / prod 部署：cloudflared 與 app 同在 docker bridge network，
#   來源為該 network 的 container IP；**必須**填 docker bridge CIDR 才能信任
#   cloudflared 送來的 X-Forwarded-Proto: https，讓 Secure cookie 與 scheme 偵測
#   端到端成立。
#   ⚠️ 若此處留空（或註解掉）卻以 tunnel/prod 啟動，uvicorn 會「不信任任何 proxy」，
#      內層 HTTP 連線被判為 plain http，Secure cookie flag 永不設定，端到端 HTTPS
#      session 安全形同失效——故預設直接提供建議值，避免 cp .env.example .env 後漏設。
#   注意：請勿設為 *（信任所有來源）；明確 CIDR 可避免日後有人加 publish 時被偽造
#         X-Forwarded-*。
FORWARDED_ALLOW_IPS=172.16.0.0/12

# ── 部署 / GHCR 映像（image）────────────────────────────────────────────────
# 預設 `docker compose up` 會 pull ghcr.io/fhcst/dprs:${APP_IMAGE_TAG}。

# [選填] 要 pull 的映像 tag（預設 latest）。可固定為特定版本（如 1.2.3）以利 rollback。
APP_IMAGE_TAG=latest

# Bootstrapping 注意：在首個映像 publish 至 GHCR 之前，`docker compose up` 無法
# pull。首次使用者請先執行 `docker compose --profile build build` 產生本機映像
# （同 tag），之後 `docker compose up` 才能直接啟動。

# ── Cloudflare Tunnel（僅 tunnel profile）────────────────────────────────────
# 啟用方式：docker compose --profile tunnel up -d
# tunnel 作為唯一對外入口；ingress route（指向 http://app:8000）於 Cloudflare
# dashboard 設定，repo 內不需 config.yml / credentials。

# [必填（tunnel profile）] remotely-managed tunnel 的連線 token。
# 於 Cloudflare Zero Trust dashboard 建立 tunnel 後取得；切勿提交真實 token，
# 此處僅為 placeholder。
TUNNEL_TOKEN=changeme_tunnel_token

# [選填] tunnel 連線傳輸協定：auto | http2 | quic（預設 auto）。
TUNNEL_TRANSPORT_PROTOCOL=auto

# ── MongoDB 備份（僅 backup profile，選配）──────────────────────────────────
# 主力備份機制為 scripts/backup.sh（讀本檔的 MONGO_* 認證）。
# 若改用常駐排程 service：docker compose --profile backup up -d

# [選填] mongo-backup service 兩次備份的間隔秒數（預設 86400 = 24 小時）。
BACKUP_INTERVAL_SECONDS=86400

# ── 安全備註：SEC-DESIGN-001（CSRF / SameSite 策略不變）──────────────────────
# 本部署在 app 前方加入「受信任的 reverse proxy」（Cloudflare Tunnel），
# 不更動 cookie SameSite=Lax，也不更動 JSON-API 的 CSRF 策略
# （CORS preflight + SameSite cookie 雙層防護）。FORWARDED_ALLOW_IPS 僅影響
# scheme 偵測（讓 Secure cookie 正確），與 SameSite / CORS 政策無關。
# 詳見 docs/security-notes.md SEC-DESIGN-001。

# ── Mongo Express（僅 debug profile）────────────────────────────────────────
# 啟用方式：docker compose --profile debug up

# [選填] Mongo Express Web UI 的 Basic Auth 帳號密碼
ME_USER=admin
ME_PASSWORD=changeme_me
